## 🎯 Filtros e Refinamento

### **✅ DO: Sistema de Filtros**

```tsx
// ✅ DO: Componente de filtros de busca
export function SearchFilters({
  filters,
  onFilterChange,
}: SearchFiltersProps) {
  return (
    <aside className="search-filters" aria-label="Filtros de busca">
      <h2>Filtrar Resultados</h2>

      {/* Filtro por categoria */}
      <div className="filter-group">
        <h3>Categoria</h3>
        <ul>
          {categories.map((category) => (
            <li key={category.id}>
              <label>
                <input
                  type="checkbox"
                  checked={filters.categories.includes(category.id)}
                  onChange={(e) => {
                    const newCategories = e.target.checked
                      ? [...filters.categories, category.id]
                      : filters.categories.filter((id) => id !== category.id);
                    onFilterChange({ ...filters, categories: newCategories });
                  }}
                />
                {category.name} ({category.count})
              </label>
            </li>
          ))}
        </ul>
      </div>

      {/* Filtro por data */}
      <div className="filter-group">
        <h3>Data</h3>
        <select
          value={filters.dateRange}
          onChange={(e) =>
            onFilterChange({ ...filters, dateRange: e.target.value })
          }
        >
          <option value="all">Todas as datas</option>
          <option value="day">Últimas 24 horas</option>
          <option value="week">Última semana</option>
          <option value="month">Último mês</option>
          <option value="year">Último ano</option>
        </select>
      </div>

      {/* Botão de limpar filtros */}
      <button
        onClick={() => onFilterChange({ categories: [], dateRange: 'all' })}
        className="clear-filters"
      >
        Limpar Filtros
      </button>
    </aside>
  );
}
```

