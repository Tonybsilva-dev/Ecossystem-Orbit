## 🎓 Autoridade e Expertise (E-E-A-T)

### **✅ DO: Demonstrar Autoridade**

```tsx
// ✅ DO: Informações de autoridade visíveis
export function AuthorSection({ author }: { author: Author }) {
  return (
    <aside className="author-info">
      <img 
        src={author.avatar} 
        alt={author.name} 
        title={author.name}
      />
      <div>
        <h3>{author.name}</h3>
        <p>{author.bio}</p>
        <p>
          <strong>Experiência:</strong> {author.experience} anos
        </p>
        <p>
          <strong>Especialização:</strong> {author.specialization}
        </p>
        {author.credentials && (
          <p>
            <strong>Credenciais:</strong> {author.credentials}
          </p>
        )}
      </div>
    </aside>
  );
}
```

### **✅ DO: Citações e Referências**

```tsx
// ✅ DO: Citações estruturadas
export function CitationSection({ citations }: { citations: Citation[] }) {
  return (
    <section className="citations">
      <h2>Referências</h2>
      <ol>
        {citations.map((citation, index) => (
          <li key={index}>
            <cite>
              <a href={citation.url} title={citation.title}>
                {citation.title}
              </a>
            </cite>
            {citation.author && (
              <span> - {citation.author}</span>
            )}
          </li>
        ))}
      </ol>
    </section>
  );
}
```

