## 📊 Métricas e Monitoramento

### **✅ DO: Rastreamento de Citações**

```tsx
// ✅ DO: Rastrear quando o site é citado por assistentes de IA
export function useAEOAnalytics() {
  useEffect(() => {
    // Rastrear referências de assistentes de IA
    const trackCitation = (source: string) => {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'aeo_citation', {
          source,
          page_path: window.location.pathname,
        });
      }
    };

    // Monitorar referências (exemplo: Perplexity, ChatGPT)
    // Implementar lógica de detecção de citações

    return () => {
      // Cleanup
    };
  }, []);
}
```

