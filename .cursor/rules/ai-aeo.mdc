## 🔗 Citações e Links

### **✅ DO: Links para Fontes Confiáveis**

```tsx
// ✅ DO: Links para fontes autoritárias
export function ReferenceLinks({ references }: { references: Reference[] }) {
  return (
    <section className="references">
      <h2>Fontes e Referências</h2>
      <ul>
        {references.map((ref, index) => (
          <li key={index}>
            <a 
              href={ref.url} 
              title={ref.title}
              rel="nofollow"
            >
              {ref.title}
            </a>
            {ref.domain && (
              <span className="domain"> ({ref.domain})</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  );
}
