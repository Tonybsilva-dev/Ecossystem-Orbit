## 🗄️ Cache e Persistência Unificada

### **✅ DO: Sistema de Cache Centralizado**

```typescript
// ✅ DO: Cache unificado com múltiplas estratégias
export class CacheService {
  private static memoryCache = new Map<string, { data: unknown; expires: number }>();
  private static storage: Storage = localStorage;

  static set(
    key: string,
    value: unknown,
    options?: { ttl?: number; storage?: 'memory' | 'localStorage' }
  ) {
    const { ttl = 0, storage = 'memory' } = options || {};
    const expires = ttl > 0 ? Date.now() + ttl : 0;

    if (storage === 'localStorage') {
      try {
        this.storage.setItem(
          key,
          JSON.stringify({ data: value, expires })
        );
      } catch (error) {
        console.error('Erro ao salvar no localStorage:', error);
      }
    } else {
      this.memoryCache.set(key, { data: value, expires });
    }
  }

  static get<T>(key: string, storage: 'memory' | 'localStorage' = 'memory'): T | null {
    if (storage === 'localStorage') {
      try {
        const item = this.storage.getItem(key);
        if (!item) return null;

        const { data, expires } = JSON.parse(item);
        if (expires > 0 && expires < Date.now()) {
          this.storage.removeItem(key);
          return null;
        }

        return data as T;
      } catch (error) {
        console.error('Erro ao ler do localStorage:', error);
        return null;
      }
    } else {
      const item = this.memoryCache.get(key);
      if (!item) return null;

      if (item.expires > 0 && item.expires < Date.now()) {
        this.memoryCache.delete(key);
        return null;
      }

      return item.data as T;
    }
  }

  static clear(pattern?: string) {
    if (pattern) {
      // Limpar por padrão
      this.memoryCache.forEach((_, key) => {
        if (key.includes(pattern)) {
          this.memoryCache.delete(key);
        }
      });
    } else {
      // Limpar tudo
      this.memoryCache.clear();
    }
  }
}
```

