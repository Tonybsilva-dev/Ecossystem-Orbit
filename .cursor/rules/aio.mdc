## 🔔 Notificações Unificadas

### **✅ DO: Sistema de Notificações Centralizado**

```typescript
// ✅ DO: Service unificado de notificações
export class NotificationService {
  private static channels: NotificationChannel[] = [];

  static registerChannel(channel: NotificationChannel) {
    this.channels.push(channel);
  }

  static async send(
    message: string,
    options?: NotificationOptions
  ): Promise<void> {
    const { channels = ['toast'], ...rest } = options || {};

    await Promise.allSettled(
      this.channels
        .filter((channel) => channels.includes(channel.type))
        .map((channel) => channel.send(message, rest))
    );
  }

  static success(message: string, options?: NotificationOptions) {
    return this.send(message, { ...options, type: 'success' });
  }

  static error(message: string, options?: NotificationOptions) {
    return this.send(message, { ...options, type: 'error' });
  }

  static info(message: string, options?: NotificationOptions) {
    return this.send(message, { ...options, type: 'info' });
  }

  static warning(message: string, options?: NotificationOptions) {
    return this.send(message, { ...options, type: 'warning' });
  }
}

// ✅ DO: Canais de notificação
interface NotificationChannel {
  type: 'toast' | 'email' | 'push' | 'sms';
  send(message: string, options?: NotificationOptions): Promise<void>;
}

// Exemplo: Toast Channel
class ToastChannel implements NotificationChannel {
  type = 'toast' as const;

  async send(message: string, options?: NotificationOptions) {
    const { type = 'info', ...rest } = options || {};
    
    switch (type) {
      case 'success':
        toast.success(message, rest);
        break;
      case 'error':
        toast.error(message, rest);
        break;
      case 'warning':
        toast.warning(message, rest);
        break;
      default:
        toast.info(message, rest);
    }
  }
}

// Registrar canais
NotificationService.registerChannel(new ToastChannel());
```

