## 🔄 Sincronização e Estado Global

### **✅ DO: Store Unificado para Configurações**

```typescript
// ✅ DO: Store Zustand para configurações globais
import { create } from 'zustand';
import { persist } from 'zustand/middleware';

interface AppConfigState {
  theme: 'light' | 'dark' | 'system';
  language: string;
  notifications: {
    email: boolean;
    push: boolean;
    sms: boolean;
  };
  preferences: Record<string, unknown>;
  setTheme: (theme: 'light' | 'dark' | 'system') => void;
  setLanguage: (language: string) => void;
  updateNotifications: (notifications: Partial<AppConfigState['notifications']>) => void;
  updatePreferences: (key: string, value: unknown) => void;
  reset: () => void;
}

const defaultState = {
  theme: 'system' as const,
  language: 'pt-BR',
  notifications: {
    email: true,
    push: true,
    sms: false,
  },
  preferences: {},
};

export const useAppConfigStore = create<AppConfigState>()(
  persist(
    (set) => ({
      ...defaultState,
      setTheme: (theme) => set({ theme }),
      setLanguage: (language) => set({ language }),
      updateNotifications: (notifications) =>
        set((state) => ({
          notifications: { ...state.notifications, ...notifications },
        })),
      updatePreferences: (key, value) =>
        set((state) => ({
          preferences: { ...state.preferences, [key]: value },
        })),
      reset: () => set(defaultState),
    }),
    { name: 'app-config-storage' }
  )
);
```

