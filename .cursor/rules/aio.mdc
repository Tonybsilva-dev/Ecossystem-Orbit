## ⚙️ Configuração e Feature Flags

### **✅ DO: Sistema de Feature Flags**

```typescript
// ✅ DO: Feature flags centralizados
export const FEATURE_FLAGS = {
  enableNewDashboard: import.meta.env.VITE_ENABLE_NEW_DASHBOARD === 'true',
  enableAdvancedSearch: import.meta.env.VITE_ENABLE_ADVANCED_SEARCH === 'true',
  enableAnalytics: import.meta.env.VITE_ENABLE_ANALYTICS === 'true',
  enableNotifications: import.meta.env.VITE_ENABLE_NOTIFICATIONS === 'true',
} as const;

// ✅ DO: Hook para verificar feature flags
export function useFeatureFlag(flag: keyof typeof FEATURE_FLAGS): boolean {
  return FEATURE_FLAGS[flag];
}

// ✅ DO: Componente condicional baseado em feature flag
export function FeatureGate({
  flag,
  children,
  fallback = null,
}: {
  flag: keyof typeof FEATURE_FLAGS;
  children: React.ReactNode;
  fallback?: React.ReactNode;
}) {
  const isEnabled = useFeatureFlag(flag);
  return isEnabled ? <>{children}</> : <>{fallback}</>;
}
```

