## 📊 Analytics e Monitoramento Unificado

### **✅ DO: Sistema de Analytics Centralizado**

```typescript
// ✅ DO: Service unificado de analytics
export class AnalyticsService {
  private static providers: AnalyticsProvider[] = [];

  static registerProvider(provider: AnalyticsProvider) {
    this.providers.push(provider);
  }

  static async trackEvent(
    eventName: string,
    properties?: Record<string, unknown>
  ) {
    // Enviar para todos os providers registrados
    await Promise.allSettled(
      this.providers.map((provider) =>
        provider.trackEvent(eventName, properties)
      )
    );
  }

  static async trackPageView(path: string) {
    await Promise.allSettled(
      this.providers.map((provider) => provider.trackPageView(path))
    );
  }

  static async identify(userId: string, traits?: Record<string, unknown>) {
    await Promise.allSettled(
      this.providers.map((provider) => provider.identify(userId, traits))
    );
  }
}

// ✅ DO: Implementação de providers
interface AnalyticsProvider {
  trackEvent(eventName: string, properties?: Record<string, unknown>): Promise<void>;
  trackPageView(path: string): Promise<void>;
  identify(userId: string, traits?: Record<string, unknown>): Promise<void>;
}

// Exemplo: Google Analytics
class GoogleAnalyticsProvider implements AnalyticsProvider {
  async trackEvent(eventName: string, properties?: Record<string, unknown>) {
    if (typeof gtag !== 'undefined') {
      gtag('event', eventName, properties);
    }
  }

  async trackPageView(path: string) {
    if (typeof gtag !== 'undefined') {
      gtag('config', ENV_CONFIG.analyticsId, { page_path: path });
    }
  }

  async identify(userId: string, traits?: Record<string, unknown>) {
    if (typeof gtag !== 'undefined') {
      gtag('set', { user_id: userId, ...traits });
    }
  }
}

// Registrar providers
if (ENV_CONFIG.analyticsId) {
  AnalyticsService.registerProvider(new GoogleAnalyticsProvider());
}
```

