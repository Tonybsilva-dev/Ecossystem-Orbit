# GEO Guidelines - Diretrizes de Geolocalização

## **Visão Geral**

Diretrizes completas para implementação de funcionalidades baseadas em geolocalização, incluindo mapas interativos, busca por localização, cálculo de distâncias, e integração com serviços de geocodificação.

---

## 🗺️ Mapas e Visualização

### **Bibliotecas Recomendadas**

- **Leaflet** - Biblioteca open-source leve e flexível
- **Mapbox GL JS** - Renderização vetorial de alta performance
- **Google Maps API** - Solução completa e robusta

### **✅ DO: Implementação de Mapas**

```typescript
// ✅ DO: Hook para gerenciar estado do mapa
import { useState, useEffect, useRef } from 'react';
import L from 'leaflet';

export function useMap(center: [number, number], zoom: number = 13) {
  const mapRef = useRef<L.Map | null>(null);
  const [map, setMap] = useState<L.Map | null>(null);

  useEffect(() => {
    if (!mapRef.current) {
      const mapInstance = L.map('map', {
        center,
        zoom,
      });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
      }).addTo(mapInstance);

      mapRef.current = mapInstance;
      setMap(mapInstance);
    }

    return () => {
      if (mapRef.current) {
        mapRef.current.remove();
        mapRef.current = null;
      }
    };
  }, []);

  return { map, mapRef };
}
```

### **✅ DO: Marcadores e Popups**

```typescript
// ✅ DO: Adicionar marcadores com popups informativos
export function useMapMarkers(map: L.Map | null, locations: Location[]) {
  const markersRef = useRef<L.Marker[]>([]);

  useEffect(() => {
    if (!map) return;

    // Limpar marcadores anteriores
    markersRef.current.forEach(marker => marker.remove());

    // Adicionar novos marcadores
    const newMarkers = locations.map(location => {
      const marker = L.marker([location.lat, location.lng])
        .addTo(map)
        .bindPopup(`
          <div>
            <h3>${location.name}</h3>
            <p>${location.address}</p>
            ${location.distance ? `<p>Distância: ${location.distance} km</p>` : ''}
          </div>
        `);

      return marker;
    });

    markersRef.current = newMarkers;

    // Ajustar view para mostrar todos os marcadores
    if (newMarkers.length > 0) {
      const group = new L.FeatureGroup(newMarkers);
      map.fitBounds(group.getBounds().pad(0.1));
    }
  }, [map, locations]);
}
```

