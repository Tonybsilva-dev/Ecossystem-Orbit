## 🎯 Autocomplete de Endereços

### **✅ DO: Autocomplete com Debounce**

```typescript
// ✅ DO: Hook para autocomplete de endereços
import { useState, useEffect } from 'react';
import { useDebouncedCallback } from 'use-debounce';

export function useAddressAutocomplete() {
  const [query, setQuery] = useState('');
  const [suggestions, setSuggestions] = useState<AddressSuggestion[]>([]);
  const [loading, setLoading] = useState(false);

  const searchAddresses = useDebouncedCallback(async (searchQuery: string) => {
    if (searchQuery.length < 3) {
      setSuggestions([]);
      return;
    }

    setLoading(true);
    try {
      const response = await fetch(
        `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(searchQuery)}&limit=5`,
        {
          headers: {
            'User-Agent': '[Nome do Projeto]',
          },
        }
      );

      const data = await response.json();
      setSuggestions(
        data.map((item: any) => ({
          id: item.place_id,
          address: item.display_name,
          lat: parseFloat(item.lat),
          lng: parseFloat(item.lon),
        }))
      );
    } catch (error) {
      console.error('Erro no autocomplete:', error);
      toast.error('Erro ao buscar endereços');
    } finally {
      setLoading(false);
    }
  }, 300);

  useEffect(() => {
    searchAddresses(query);
  }, [query, searchAddresses]);

  return { query, setQuery, suggestions, loading };
}
```

