### **✅ DO: Cache de Geocodificação**

```typescript
// ✅ DO: Cache de resultados de geocodificação
const geocodeCache = new Map<string, GeocodeResult>();

export class CachedGeocodingService {
  static async geocode(address: string): Promise<GeocodeResult | null> {
    // Verificar cache
    if (geocodeCache.has(address)) {
      return geocodeCache.get(address)!;
    }

    // Buscar e cachear
    const result = await GeocodingService.geocode(address);
    if (result) {
      geocodeCache.set(address, result);
    }

    return result;
  }
}
```

