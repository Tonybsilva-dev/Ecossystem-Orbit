## 🔍 Geocodificação e Reverse Geocoding

### **✅ DO: Geocodificação (Endereço → Coordenadas)**

```typescript
// ✅ DO: Service para geocodificação
export class GeocodingService {
  static async geocode(address: string): Promise<GeocodeResult | null> {
    try {
      // Exemplo com OpenStreetMap Nominatim (gratuito)
      const response = await fetch(
        `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=1`,
        {
          headers: {
            'User-Agent': '[Nome do Projeto]',
          },
        }
      );

      const data = await response.json();
      
      if (data.length === 0) {
        return null;
      }

      const result = data[0];
      return {
        lat: parseFloat(result.lat),
        lng: parseFloat(result.lon),
        address: result.display_name,
        formatted: {
          street: result.address?.road || '',
          city: result.address?.city || result.address?.town || '',
          state: result.address?.state || '',
          country: result.address?.country || '',
          postalCode: result.address?.postcode || '',
        },
      };
    } catch (error) {
      console.error('Erro na geocodificação:', error);
      throw new Error('Erro ao buscar localização');
    }
  }
}
```

### **✅ DO: Reverse Geocoding (Coordenadas → Endereço)**

```typescript
// ✅ DO: Service para reverse geocoding
export class ReverseGeocodingService {
  static async reverseGeocode(
    lat: number,
    lng: number
  ): Promise<GeocodeResult | null> {
    try {
      const response = await fetch(
        `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`,
        {
          headers: {
            'User-Agent': '[Nome do Projeto]',
          },
        }
      );

      const data = await response.json();
      
      if (!data || !data.address) {
        return null;
      }

      return {
        lat,
        lng,
        address: data.display_name,
        formatted: {
          street: data.address?.road || '',
          city: data.address?.city || data.address?.town || '',
          state: data.address?.state || '',
          country: data.address?.country || '',
          postalCode: data.address?.postcode || '',
        },
      };
    } catch (error) {
      console.error('Erro no reverse geocoding:', error);
      throw new Error('Erro ao buscar endereço');
    }
  }
}
```

