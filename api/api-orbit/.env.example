DATABASE_URL="postgresql://user:password@localhost:5432/orbit"

# Secret compartilhado — único gate de acesso ao operador (tenants, planos,
# kill switch, pagamentos). Mesmo valor usado pelos backends dos tenant apps
# que chamam /tenants/sync.
ORBIT_API_SECRET="troque-por-uma-chave-forte-com-16+chars"

OPENAI_API_KEY=""
GOOGLE_GEMINI_API_KEY=""

NODE_ENV="development"
PORT="4001"
HOST="0.0.0.0"
