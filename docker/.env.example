# Copie para docker/.env e preencha antes de "docker compose up".
# Chaves padronizadas entre todos os serviços do Ecossystem.

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_ORBIT_DB=orbit
POSTGRES_BARBERFLOW_DB=barberflow

# ---- Secret compartilhado (server-to-server: api-orbit <-> tenant apps) ----
ORBIT_API_SECRET=change-me-shared-secret

# ---- api-orbit (control plane: tenants, planos, kill switch, IA) ----
API_ORBIT_PORT=4001
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# ---- orbit (UI admin) ----
ORBIT_PORT=5179
SESSION_SECRET=change-me

# ---- barber-flow ----
BARBERFLOW_PORT=3333
BETTER_AUTH_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- URLs públicas ----
# Alcançadas pelo browser (Vite inlina VITE_ORBIT_API_URL no build a partir de
# PUBLIC_API_ORBIT_URL) e por redirects/cookies do BetterAuth — diferentes das
# URLs internas de rede Docker (api-orbit:4001) usadas nas chamadas
# server-to-server dentro do compose.
PUBLIC_API_ORBIT_URL=http://localhost:4001
PUBLIC_BARBERFLOW_URL=http://localhost:3333
