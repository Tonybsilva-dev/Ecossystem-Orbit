```tsx
// ✅ DO: Apresentar dados com fontes claras
export function DataSection({ data, source }: { data: DataPoint[]; source: Source }) {
  return (
    <section className="data-section">
      <h2>Dados e Estatísticas</h2>
      
      <table>
        <thead>
          <tr>
            <th>Métrica</th>
            <th>Valor</th>
            <th>Período</th>
          </tr>
        </thead>
        <tbody>
          {data.map((point, index) => (
            <tr key={index}>
              <td>{point.metric}</td>
              <td>{point.value}</td>
              <td>{point.period}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <footer className="data-source">
        <p>
          <strong>Fonte:</strong>{' '}
          <a href={source.url} title={source.title}>
            {source.title}
          </a>
          {source.date && ` (${source.date})`}
        </p>
      </footer>
    </section>
  );
}
```

