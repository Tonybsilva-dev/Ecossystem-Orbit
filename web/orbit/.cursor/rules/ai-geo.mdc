## 📚 Conteúdo Educacional

### **✅ DO: Tutoriais Completos**

```tsx
// ✅ DO: Tutorial completo e passo a passo
export function TutorialPage({ tutorial }: { tutorial: Tutorial }) {
  return (
    <article>
      <header>
        <h1>{tutorial.title}</h1>
        <p className="description">{tutorial.description}</p>
        <div className="meta">
          <span>Tempo estimado: {tutorial.duration}</span>
          <span>Nível: {tutorial.level}</span>
        </div>
      </header>

      {/* Pré-requisitos */}
      {tutorial.prerequisites && (
        <section className="prerequisites">
          <h2>Pré-requisitos</h2>
          <ul>
            {tutorial.prerequisites.map((req, index) => (
              <li key={index}>{req}</li>
            ))}
          </ul>
        </section>
      )}

      {/* Objetivos de aprendizado */}
      <section className="learning-objectives">
        <h2>O que você vai aprender</h2>
        <ul>
          {tutorial.learningObjectives.map((objective, index) => (
            <li key={index}>{objective}</li>
          ))}
        </ul>
      </section>

      {/* Conteúdo principal */}
      {tutorial.sections.map((section, index) => (
        <section key={index} className="tutorial-section">
          <h2>{section.title}</h2>
          <div dangerouslySetInnerHTML={{ __html: section.content }} />
          
          {section.codeExample && (
            <pre>
              <code>{section.codeExample}</code>
            </pre>
          )}
        </section>
      ))}

      {/* Resumo */}
      <section className="summary">
        <h2>Resumo</h2>
        <p>{tutorial.summary}</p>
      </section>

      {/* Próximos passos */}
      {tutorial.nextSteps && (
        <section className="next-steps">
          <h2>Próximos Passos</h2>
          <ul>
            {tutorial.nextSteps.map((step, index) => (
              <li key={index}>{step}</li>
            ))}
          </ul>
        </section>
      )}
    </article>
  );
}
```

