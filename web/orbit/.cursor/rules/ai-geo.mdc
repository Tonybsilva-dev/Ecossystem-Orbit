## 📊 Dados Estruturados Avançados

### **✅ DO: ScholarlyArticle Schema**

```tsx
// ✅ DO: ScholarlyArticle para conteúdo acadêmico/autoritativo
export function useScholarlyArticleSchema(article: ScholarlyArticle) {
  useEffect(() => {
    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.textContent = JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ScholarlyArticle',
      headline: article.title,
      description: article.description,
      author: {
        '@type': 'Person',
        name: article.author.name,
        jobTitle: article.author.title,
        affiliation: {
          '@type': 'Organization',
          name: article.author.affiliation,
        },
        sameAs: article.author.socialLinks,
      },
      publisher: {
        '@type': 'Organization',
        name: '[Nome da Organização]',
        logo: {
          '@type': 'ImageObject',
          url: '[URL do Logo]',
        },
      },
      datePublished: article.publishedAt,
      dateModified: article.updatedAt,
      articleSection: article.category,
      keywords: article.keywords.join(', '),
      inLanguage: 'pt-BR',
      citation: article.citations.map((cite) => ({
        '@type': 'CreativeWork',
        name: cite.title,
        url: cite.url,
      })),
    });
    document.head.appendChild(script);

    return () => {
      document.head.removeChild(script);
    };
  }, [article]);
}
```

### **✅ DO: Course Schema para Tutoriais**

```tsx
// ✅ DO: Course Schema para conteúdo educacional
export function useCourseSchema(course: Course) {
  useEffect(() => {
    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.textContent = JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: course.name,
      description: course.description,
      provider: {
        '@type': 'Organization',
        name: '[Nome da Organização]',
      },
      courseCode: course.code,
      educationalLevel: course.level,
      teaches: course.learningOutcomes,
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'online',
        duration: course.duration,
      },
    });
    document.head.appendChild(script);

    return () => {
      document.head.removeChild(script);
    };
  }, [course]);
}
```

