## 🔗 Citações e Referências

### **✅ DO: Referências Acadêmicas**

```tsx
// ✅ DO: Seção de referências estruturada
export function ReferencesSection({ references }: { references: Reference[] }) {
  return (
    <section className="references">
      <h2>Referências</h2>
      <ol>
        {references.map((ref, index) => (
          <li key={index} id={`ref-${index + 1}`}>
            <cite>
              {ref.authors && `${ref.authors}. `}
              <strong>{ref.title}</strong>.
              {ref.publication && ` ${ref.publication},`}
              {ref.year && ` ${ref.year}.`}
              {ref.url && (
                <>
                  {' '}
                  <a href={ref.url} title={ref.title}>
                    {ref.url}
                  </a>
                </>
              )}
            </cite>
          </li>
        ))}
      </ol>
    </section>
  );
}
```

