## 📝 Processamento de Dados

### **✅ DO: Extração de Informações**

```typescript
// ✅ DO: Service para extração estruturada de informações
export class DataExtractionService {
  static async extractEntities(text: string): Promise<Entity[]> {
    const prompt = `Extraia as entidades (pessoas, lugares, organizações) do seguinte texto e retorne JSON array: ${text}`;
    
    const response = await AIService.generateText(prompt, {
      temperature: 0.3,
      maxTokens: 500,
    });

    try {
      return JSON.parse(response);
    } catch (error) {
      console.error('Erro ao parsear entidades:', error);
      return [];
    }
  }

  static async summarize(text: string, maxLength: number = 200): Promise<string> {
    const prompt = `Resuma o seguinte texto em no máximo ${maxLength} caracteres: ${text}`;
    
    return AIService.generateText(prompt, {
      temperature: 0.5,
      maxTokens: Math.ceil(maxLength / 4), // Aproximação
    });
  }

  static async extractKeywords(text: string, count: number = 5): Promise<string[]> {
    const prompt = `Extraia as ${count} palavras-chave mais importantes do seguinte texto e retorne JSON array: ${text}`;
    
    const response = await AIService.generateText(prompt, {
      temperature: 0.3,
      maxTokens: 100,
    });

    try {
      return JSON.parse(response);
    } catch (error) {
      console.error('Erro ao extrair palavras-chave:', error);
      return [];
    }
  }
}
