# AI-AIO Guidelines - AI Integration Optimization

## **Visão Geral**

Diretrizes para otimização de integrações com modelos de IA, incluindo APIs de linguagem, processamento de dados, e implementação de funcionalidades baseadas em IA.

---

## 🤖 Integração com APIs de IA

### **✅ DO: Cliente Unificado para APIs de IA**

```typescript
// ✅ DO: Service centralizado para múltiplas APIs de IA
export class AIService {
  private static providers: AIProvider[] = [];

  static registerProvider(provider: AIProvider) {
    this.providers.push(provider);
  }

  static async generateText(
    prompt: string,
    options?: AIGenerateOptions
  ): Promise<string> {
    const provider = this.getProvider(options?.provider);
    return provider.generateText(prompt, options);
  }

  static async analyzeSentiment(text: string): Promise<SentimentAnalysis> {
    const provider = this.getProvider();
    return provider.analyzeSentiment(text);
  }

  static async translate(
    text: string,
    targetLanguage: string
  ): Promise<string> {
    const provider = this.getProvider();
    return provider.translate(text, targetLanguage);
  }

  private static getProvider(name?: string): AIProvider {
    if (name) {
      const provider = this.providers.find((p) => p.name === name);
      if (!provider) {
        throw new Error(`Provider ${name} not found`);
      }
      return provider;
    }
    return this.providers[0]; // Default provider
  }
}

// ✅ DO: Interface para providers
interface AIProvider {
  name: string;
  generateText(prompt: string, options?: AIGenerateOptions): Promise<string>;
  analyzeSentiment(text: string): Promise<SentimentAnalysis>;
  translate(text: string, targetLanguage: string): Promise<string>;
}
```

### **✅ DO: Implementação de Provider (OpenAI)**

```typescript
// ✅ DO: Provider específico para OpenAI
import OpenAI from 'openai';

export class OpenAIProvider implements AIProvider {
  name = 'openai';
  private client: OpenAI;

  constructor(apiKey: string) {
    this.client = new OpenAI({ apiKey });
  }

  async generateText(
    prompt: string,
    options?: AIGenerateOptions
  ): Promise<string> {
    try {
      const response = await this.client.chat.completions.create({
        model: options?.model || 'gpt-4',
        messages: [{ role: 'user', content: prompt }],
        temperature: options?.temperature || 0.7,
        max_tokens: options?.maxTokens || 1000,
      });

      return response.choices[0]?.message?.content || '';
    } catch (error) {
      console.error('Erro ao gerar texto:', error);
      throw new Error('Erro ao gerar texto com IA');
    }
  }

  async analyzeSentiment(text: string): Promise<SentimentAnalysis> {
    const prompt = `Analise o sentimento do seguinte texto e retorne apenas JSON com "sentiment" (positive/negative/neutral) e "score" (0-1): ${text}`;
    
    const response = await this.generateText(prompt, {
      temperature: 0.3,
      maxTokens: 100,
    });

    return JSON.parse(response);
  }

  async translate(text: string, targetLanguage: string): Promise<string> {
    const prompt = `Traduza o seguinte texto para ${targetLanguage}: ${text}`;
    return this.generateText(prompt, { temperature: 0.3 });
  }
}
```

