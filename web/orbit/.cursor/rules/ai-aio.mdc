## 🔍 Busca Semântica

### **✅ DO: Busca com Embeddings**

```typescript
// ✅ DO: Service para busca semântica
export class SemanticSearchService {
  private static embeddings: Map<string, number[]> = new Map();

  static async generateEmbedding(text: string): Promise<number[]> {
    // Usar API de embeddings (ex: OpenAI embeddings)
    const response = await fetch('https://api.openai.com/v1/embeddings', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${import.meta.env.VITE_OPENAI_API_KEY}`,
      },
      body: JSON.stringify({
        model: 'text-embedding-ada-002',
        input: text,
      }),
    });

    const data = await response.json();
    return data.data[0].embedding;
  }

  static async search(
    query: string,
    documents: Document[]
  ): Promise<Document[]> {
    const queryEmbedding = await this.generateEmbedding(query);

    // Calcular similaridade (cosine similarity)
    const results = documents.map((doc) => {
      const docEmbedding = this.embeddings.get(doc.id) || [];
      const similarity = this.cosineSimilarity(queryEmbedding, docEmbedding);
      return { ...doc, similarity };
    });

    // Ordenar por similaridade
    return results
      .sort((a, b) => b.similarity - a.similarity)
      .filter((doc) => doc.similarity > 0.7); // Threshold
  }

  private static cosineSimilarity(a: number[], b: number[]): number {
    if (a.length !== b.length) return 0;

    let dotProduct = 0;
    let normA = 0;
    let normB = 0;

    for (let i = 0; i < a.length; i++) {
      dotProduct += a[i] * b[i];
      normA += a[i] * a[i];
      normB += b[i] * b[i];
    }

    return dotProduct / (Math.sqrt(normA) * Math.sqrt(normB));
  }
}
```

