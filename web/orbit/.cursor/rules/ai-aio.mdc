## ⚡ Performance e Rate Limiting

### **✅ DO: Rate Limiting e Retry**

```typescript
// ✅ DO: Rate limiter para APIs de IA
export class RateLimitedAIService {
  private static queue: Array<() => Promise<void>> = [];
  private static processing = false;
  private static requestsPerMinute = 60;
  private static requestTimes: number[] = [];

  static async generateText(
    prompt: string,
    options?: AIGenerateOptions
  ): Promise<string> {
    return new Promise((resolve, reject) => {
      this.queue.push(async () => {
        try {
          // Verificar rate limit
          await this.checkRateLimit();

          // Fazer requisição
          const result = await AIService.generateText(prompt, options);
          resolve(result);
        } catch (error) {
          reject(error);
        }
      });

      this.processQueue();
    });
  }

  private static async checkRateLimit() {
    const now = Date.now();
    const oneMinuteAgo = now - 60000;

    // Remover requisições antigas
    this.requestTimes = this.requestTimes.filter(
      (time) => time > oneMinuteAgo
    );

    // Verificar se excedeu o limite
    if (this.requestTimes.length >= this.requestsPerMinute) {
      const oldestRequest = this.requestTimes[0];
      const waitTime = 60000 - (now - oldestRequest);
      await new Promise((resolve) => setTimeout(resolve, waitTime));
    }

    this.requestTimes.push(Date.now());
  }

  private static async processQueue() {
    if (this.processing || this.queue.length === 0) return;

    this.processing = true;
    while (this.queue.length > 0) {
      const task = this.queue.shift();
      if (task) {
        await task();
      }
    }
    this.processing = false;
  }
}
```

