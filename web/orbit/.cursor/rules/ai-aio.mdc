## 🔄 Cache e Otimização

### **✅ DO: Cache de Respostas de IA**

```typescript
// ✅ DO: Cache de respostas para evitar requisições duplicadas
export class CachedAIService {
  private static cache = new Map<string, { response: string; expires: number }>();
  private static ttl = 24 * 60 * 60 * 1000; // 24 horas

  static async generateText(
    prompt: string,
    options?: AIGenerateOptions
  ): Promise<string> {
    const cacheKey = this.getCacheKey(prompt, options);

    // Verificar cache
    const cached = this.cache.get(cacheKey);
    if (cached && cached.expires > Date.now()) {
      return cached.response;
    }

    // Gerar nova resposta
    const response = await AIService.generateText(prompt, options);

    // Cachear resposta
    this.cache.set(cacheKey, {
      response,
      expires: Date.now() + this.ttl,
    });

    return response;
  }

  private static getCacheKey(
    prompt: string,
    options?: AIGenerateOptions
  ): string {
    return `${prompt}-${options?.model || 'default'}-${options?.temperature || 0.7}`;
  }

  static clearCache() {
    this.cache.clear();
  }
}
```

