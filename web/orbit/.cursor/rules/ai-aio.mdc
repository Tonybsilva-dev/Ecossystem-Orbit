## 🎯 Hooks para IA

### **✅ DO: Hook para Geração de Texto**

```typescript
// ✅ DO: Hook React para geração de texto com IA
import { useState, useCallback } from 'react';

export function useAIGenerate() {
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);
  const [result, setResult] = useState<string | null>(null);

  const generate = useCallback(async (
    prompt: string,
    options?: AIGenerateOptions
  ) => {
    setLoading(true);
    setError(null);
    setResult(null);

    try {
      const response = await CachedAIService.generateText(prompt, options);
      setResult(response);
      return response;
    } catch (err) {
      const error = err instanceof Error ? err : new Error('Erro desconhecido');
      setError(error);
      toast.error('Erro ao gerar texto com IA');
      throw error;
    } finally {
      setLoading(false);
    }
  }, []);

  return { generate, loading, error, result };
}
```

### **✅ DO: Hook para Análise de Sentimento**

```typescript
// ✅ DO: Hook para análise de sentimento
export function useSentimentAnalysis() {
  const [loading, setLoading] = useState(false);
  const [analysis, setAnalysis] = useState<SentimentAnalysis | null>(null);

  const analyze = useCallback(async (text: string) => {
    if (text.length < 10) {
      toast.warning('Texto muito curto para análise');
      return;
    }

    setLoading(true);
    try {
      const result = await AIService.analyzeSentiment(text);
      setAnalysis(result);
      return result;
    } catch (error) {
      console.error('Erro na análise de sentimento:', error);
      toast.error('Erro ao analisar sentimento');
    } finally {
      setLoading(false);
    }
  }, []);

  return { analyze, loading, analysis };
}
```

