// ✅ DO: Templates para geração de conteúdo
export class ContentGenerationService {
  static async generateEmail(
    type: 'welcome' | 'reminder' | 'notification',
    data: Record<string, string>
  ): Promise<string> {
    const templates = {
      welcome: `Bem-vindo, ${data.name}! Estamos felizes em tê-lo conosco.`,
      reminder: `Olá ${data.name}, este é um lembrete sobre ${data.subject}.`,
      notification: `Notificação: ${data.message}`,
    };

    const baseTemplate = templates[type];
    const prompt = `Gere um email profissional baseado no seguinte template: ${baseTemplate}. Dados: ${JSON.stringify(data)}`;

    return AIService.generateText(prompt, {
      temperature: 0.7,
      maxTokens: 500,
    });
  }

  static async generateSummary(content: string): Promise<string> {
    const prompt = `Gere um resumo conciso e informativo do seguinte conteúdo: ${content}`;
    
    return AIService.generateText(prompt, {
      temperature: 0.5,
      maxTokens: 200,
    });
  }
}
