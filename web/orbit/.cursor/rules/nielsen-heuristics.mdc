### **Toast Notifications**

```typescript
// ✅ DO: Toast com Sonner
import { toast } from "sonner";

export function useNotifications() {
  const showSuccess = (message: string) => {
    toast.success(message);
  };
  
  const showError = (message: string, description?: string) => {
    toast.error(message, { description });
  };
  
  const showLoading = (message: string) => {
    return toast.loading(message);
  };
  
  return { showSuccess, showError, showLoading };
}
```

## **Padrões de Loading**

### **Estados de Carregamento por Contexto**

```typescript
// ✅ DO: Loading states contextuais
export function ItemsList() {
  const { items, isLoading, error } = useItemsStore();
  
  if (isLoading) {
    return <ItemsListSkeleton />;
  }
  
  if (error) {
    return <ErrorState message="Erro ao carregar itens" onRetry={refetch} />;
  }
  
  if (items.length === 0) {
    return <EmptyItemsState />;
  }
  
  return (
    <div className="space-y-4">
      {items.map(item => (
        <ItemCard key={item.id} item={item} />
      ))}
    </div>
  );
}
```

## **Landmarks e Acessibilidade** 🏗️

### **Estrutura Semântica Obrigatória**

Aplicar landmarks HTML semânticos para melhorar navegação e acessibilidade, seguindo WCAG 2.1 AA e heurísticas de Nielsen.

#### **✅ DO: Estrutura Semântica Completa**

```typescript
// ✅ DO: Estrutura de landmarks correta
export default function HomePage() {
  return (
    <div className="min-h-screen bg-background">
      {/* Skip Link para navegação por teclado */}
      <a 
        href="#main-content" 
        className="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 bg-primary text-white px-4 py-2 rounded-md font-medium transition-all"
      >
        Pular para o conteúdo principal
      </a>
      
      {/* Header com navegação */}
      <header className="sticky top-0 z-[9999] border-b bg-white/95 backdrop-blur-md shadow-sm">
        <nav className="container mx-auto px-4 py-4" aria-label="Navegação principal">
          {/* Conteúdo da navegação */}
        </nav>
      </header>

      {/* Conteúdo principal */}
      <main id="main-content" aria-label="Conteúdo principal da página">
        {/* Seções de conteúdo */}
        <section aria-label="Apresentação">
          {/* Hero section */}
        </section>
        
        <section aria-label="Funcionalidades">
          {/* Features */}
        </section>
        
        <aside aria-label="Informações complementares">
          {/* Conteúdo complementar */}
        </aside>
      </main>

      {/* Rodapé */}
      <footer className="bg-gray-900 py-16 text-white">
        {/* Links e informações */}
      </footer>
    </div>
  );
}
```

#### **Z-Index e Camadas**

##### **✅ DO: Hierarquia de Z-Index Clara**

```typescript
// ✅ DO: Z-index organizados por camadas
const zIndexLayers = {
  skipLink: 'z-50',           // Skip link sempre visível
  header: 'z-[9999]',         // Header sempre no topo
  modal: 'z-[1000]',          // Modais e overlays
  dropdown: 'z-[100]',        // Dropdowns e tooltips
  content: 'z-10',            // Conteúdo normal
  background: 'z-0'           // Elementos de fundo
};

// Header com z-index alto
<header className={`sticky top-0 ${zIndexLayers.header} border-b bg-white/95 backdrop-blur-md shadow-sm`}>
```

