## 🌐 Open Graph (Facebook) e Twitter Cards

### **Open Graph Tags**

#### **✅ DO: Open Graph Completo**

```tsx
// ✅ DO: Hook completo para Open Graph
export function useOpenGraph(og: {
  title: string;
  description: string;
  image: string;
  url: string;
  type?: string;
  siteName?: string;
}) {
  useEffect(() => {
    const ogTags = [
      { property: 'og:title', content: og.title },
      { property: 'og:description', content: og.description },
      { property: 'og:image', content: og.image },
      { property: 'og:url', content: og.url },
      { property: 'og:type', content: og.type || 'website' },
      { property: 'og:site_name', content: og.siteName || '[Nome do Projeto]' },
      { property: 'og:locale', content: 'pt_BR' },
    ];

    ogTags.forEach(({ property, content }) => {
      let meta = document.querySelector(`meta[property="${property}"]`);
      
      if (!meta) {
        meta = document.createElement('meta');
        meta.setAttribute('property', property);
        document.head.appendChild(meta);
      }
      
      meta.setAttribute('content', content);
    });
  }, [og]);
}
```

